{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-task-model",
  "version": "1.2.2",
  "type": "module",
  "description": "OpenCode plugin for synchronous and background subagents with per-call model and reasoning selection",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "subagent",
    "task",
    "model-selection",
    "background-agents",
    "parallel-agents"
  ],
  "license": "MIT",
  "author": "Lars Hagen <larsh2690@hotmail.com>",
  "homepage": "https://github.com/lars-hagen/opencode-task-model#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lars-hagen/opencode-task-model.git"
  },
  "bugs": {
    "url": "https://github.com/lars-hagen/opencode-task-model/issues"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "opencode:install": "opencode plugin --global --force opencode-task-model@$(bun pm view opencode-task-model version)"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts"
  }
}
